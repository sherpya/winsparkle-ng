LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_UPDATE DIALOGEX 0, 0, 398, 284
STYLE DS_SETFONT | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW | WS_EX_CONTROLPARENT
CAPTION "Software Update"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    ICON IDI_WINSPARKLE, IDC_ICON, 16, 18, 32, 32, SS_REALSIZECONTROL
    LTEXT "", IDC_HEADING, 60, 16, 322, 32, SS_NOPREFIX
    LTEXT "", IDC_MESSAGE, 60, 53, 322, 42, SS_NOPREFIX
    LTEXT "", IDC_NOTES_LABEL, 16, 104, 365, 14, SS_NOPREFIX
    EDITTEXT IDC_NOTES, 16, 121, 366, 85, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_PROGRESS, PROGRESS_CLASS, WS_CHILD | PBS_SMOOTH, 60, 112, 322, 12
    LTEXT "", IDC_STATUS, 60, 132, 322, 28, SS_NOPREFIX
    PUSHBUTTON "", IDC_LINK, 16, 213, 260, 18, BS_FLAT | WS_TABSTOP
    CONTROL "", IDC_SEPARATOR, "Static", SS_ETCHEDHORZ, 0, 241, 398, 1
    PUSHBUTTON "", IDC_SKIP, 16, 254, 95, 20, WS_TABSTOP
    PUSHBUTTON "", IDC_LATER, 122, 254, 120, 20, WS_TABSTOP
    DEFPUSHBUTTON "", IDC_PRIMARY, 253, 254, 129, 20, WS_TABSTOP
    PUSHBUTTON "", IDCANCEL, 285, 254, 97, 20, WS_TABSTOP
END
